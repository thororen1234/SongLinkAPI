# Server
PORT=3000
# Public base URL used to build `pageUrl` in responses
PUBLIC_URL=http://localhost:3000
# Optional: comma-separated API keys. When set, requests must pass ?key=<one of these>
API_KEYS=
# How long resolved results are cached in memory (seconds)
CACHE_TTL_SECONDS=86400
# Default country when `userCountry` is not passed
DEFAULT_COUNTRY=US

# Spotify (https://developer.spotify.com/dashboard) needed to *find* Spotify links.
# Without it, Spotify URLs can still be used as input.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key optional. Without it, YouTube search falls back to parsing the results page.
YOUTUBE_API_KEY=

# TIDAL (https://developer.tidal.com) needed for TIDAL links.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
